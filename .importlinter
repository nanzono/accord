# 層の依存の契約。accord のコードがどの向きにだけ読み込んでよいかを、この 1 ファイルで定める。
# 手元で確かめるときは、リポジトリの直下で `uv run lint-imports` を実行する。CI も同じものを走らせる。
# 決めた理由は docs/decisions/0008-check-layer-dependencies-with-a-contract.md にある。

[importlinter]
root_package = accord
# 外部のパッケージへの読み込みも解析の対象に入れる。下の 2 本目の契約がそれを見るため。
include_external_packages = True

# 1 本目。層は上から下へだけ読む。上にある層が下にある層を読むのはよく、逆向きは落とす。
# 最後の 2 つ（models と vocabulary）は同じ段で、互いに読み合わない。
# exhaustive を立ててあるので、src/accord/ の直下に、ここに載っていないディレクトリや
# ファイルを作ると、その時点で落ちる（置き場の決まりも、この 1 本が兼ねて見ている）。
# 見るのは直下だけで、層のディレクトリの中に入れ子のディレクトリを作っても落ちない
# （入れ子の中のファイルにも、層の向きは効く）。
[importlinter:contract:layers]
name = 層は上から下へだけ読む
type = layers
containers =
    accord
layers =
    __main__
    server
    services
    repository
    models | vocabulary
exhaustive = true

# 2 本目。設定を読むモジュールは、型の意味の判断を持ち込まないよう、外部のパッケージを読まない。
# 決まりそのもの——読んでよいのは標準ライブラリと、同じ層の中のモジュールだけ——は、
# tools/check_structure.py の「設定のモジュールの依存」の項目が、読み込みを全部たどって見る。
# こちらの契約は、よくある取り違え（下に並べた 3 つを設定の側で読んでしまう書き方）を、
# 層の向きの検査と同じ 1 回の実行で早く落とすために残す。
[importlinter:contract:vocabulary-external]
name = 設定を読むモジュールは外部のパッケージを読まない
type = forbidden
source_modules =
    accord.vocabulary
forbidden_modules =
    pydantic
    yaml
    mcp
